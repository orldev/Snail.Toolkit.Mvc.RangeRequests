<Project>

  <!-- The build — language, nullable, docs, analyzers, warnings as errors, symbols, SourceLink — is Snail.Sdk's (global.json). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RepositoryUrl>https://github.com/orldev/Snail.Toolkit.Mvc.RangeRequests</RepositoryUrl>
    <!-- The last release on NuGet: a pack fails on any change that would break a user of it. Raised with each release. -->
    <SnailPackageBaseline>0.1.0</SnailPackageBaseline>
  </PropertyGroup>

</Project>
